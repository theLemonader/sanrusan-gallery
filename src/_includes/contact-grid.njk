      <div class="contact-grid reveal">
        <div>
          <p class="contact-key mono">Enquiries</p>
          <p class="contact-value"><a href="mailto:{{ site.email }}">{{ site.email }}</a></p>
        </div>
        <div>
          <p class="contact-key mono">Visit</p>
          <p class="contact-value">{{ site.address_line_1 }}<br>{{ site.address_line_2 }}</p>
        </div>
        <div>
          <p class="contact-key mono">Follow</p>
          <p class="contact-value"><a href="{{ site.instagram_url }}" target="_blank" rel="noopener">{{ site.instagram_handle }}</a></p>
        </div>
      </div>
