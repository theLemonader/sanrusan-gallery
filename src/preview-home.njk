---
permalink: /preview/index.html
eleventyComputed:
  pageTitle: "{{ home.title | safe }}"
  pageDescription: "{{ home.description | safe }}"
preloadImage: /assets/film/single-object-poster.jpg
navExhibition: "#exhibition"
navContact: "#contact"
eleventyExcludeFromCollections: true
---
<!DOCTYPE html>
<html lang="en">
<head>
{% include "head.njk" %}
  <style>
    /* ── Film stage ── */
    .stage {
      position: relative;
      height: 280vh;
      --t: 16vh; --r: var(--pad); --b: 11vh; --l: 47vw;
      --e: 0; --fade: 1; --lift: 0px; --cap: 0;
    }
    .stage-sticky {
      position: sticky;
      top: 0;
      height: 100vh;
      height: 100svh;
      overflow: hidden;
      isolation: isolate;
      background: var(--paper);
    }
    .stage-film {
      position: absolute;
      inset: 0;
      clip-path: inset(var(--t) var(--r) var(--b) var(--l));
      background: #1d1c1a;
      will-change: clip-path;
    }
    .stage-film video {
      width: 100%;
      height: 100%;
      object-fit: cover;
      scale: calc(1.16 - 0.16 * var(--e));
      opacity: 0;
      transition: opacity 1.6s var(--ease-out) 0.35s;
    }
    html:not(.js) .stage-film video, .stage-film video.is-ready { opacity: 1; }
    .stage-film::after {
      content: "";
      position: absolute;
      inset: 0;
      background: linear-gradient(to top, rgba(12, 12, 11, 0.6), rgba(12, 12, 11, 0) 45%);
      opacity: var(--cap);
    }
    html.js .stage-film { animation: film-open 1.8s var(--ease-inout) 0.2s backwards; }
    @keyframes film-open { from { clip-path: inset(calc(100vh - var(--b)) var(--r) var(--b) var(--l)); } }

    .stage-tag {
      position: absolute;
      top: calc(var(--t) - 1.7rem);
      left: var(--l);
      opacity: calc(1 - var(--e) * 4);
    }
    .stage-copy {
      position: absolute;
      top: 16vh;
      bottom: 11vh;
      left: var(--pad);
      right: var(--pad);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      align-items: flex-start;
      color: #fff;
      mix-blend-mode: difference;
      pointer-events: none;
      z-index: 2;
      opacity: var(--fade);
      transform: translate3d(0, var(--lift), 0);
    }
    .stage-intro {
      max-width: 29ch;
      font-size: clamp(0.95rem, 1.25vw, 1.12rem);
      line-height: 1.6;
      text-indent: 3em;
    }
    .stage-title { font-size: clamp(3rem, 8.4vw, 8.6rem); }
    .stage-meta {
      position: absolute;
      left: var(--pad);
      right: var(--pad);
      bottom: clamp(1.25rem, 3.5vh, 2.25rem);
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      z-index: 2;
      opacity: var(--fade);
    }
    .stage-meta > :last-child { justify-self: end; }
    .stage-scroll { display: flex; align-items: center; gap: 0.7rem; }
    .stage-scroll::after {
      content: "";
      width: 1px;
      height: 1.5rem;
      background: currentColor;
      animation: scroll-line 2.4s var(--ease-inout) infinite;
    }
    @keyframes scroll-line {
      0% { transform: scaleY(0); transform-origin: top; }
      45% { transform: scaleY(1); transform-origin: top; }
      55% { transform: scaleY(1); transform-origin: bottom; }
      100% { transform: scaleY(0); transform-origin: bottom; }
    }
    .stage-caption {
      position: absolute;
      left: var(--pad);
      right: var(--pad);
      bottom: clamp(1.5rem, 5vh, 3rem);
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      gap: 1.5rem;
      color: var(--ivory);
      z-index: 3;
      opacity: var(--cap);
      transform: translate3d(0, calc((1 - var(--cap)) * 48px), 0);
      pointer-events: none;
    }
    .stage-caption .mono { color: rgba(243, 240, 234, 0.75); }
    .stage-caption-title {
      font-size: clamp(2.4rem, 6vw, 6rem);
      font-weight: 500;
      letter-spacing: -0.035em;
      line-height: 1;
    }

    html.js .stage-meta > * {
      opacity: 0;
      transform: translateY(12px);
      animation: fade-up 1.2s var(--ease-out) 1.1s forwards;
    }
    html.js .stage-tag { animation: wipe-in 1.4s var(--ease-inout) 1.3s backwards; }
    @keyframes wipe-in { from { clip-path: inset(0 100% 0 0); } to { clip-path: inset(0 0 0 0); } }
    html.js .stage-intro { opacity: 0; transform: translateY(18px); animation: fade-up 1.4s var(--ease-out) 0.9s forwards; }
    @keyframes fade-up { to { opacity: 1; transform: none; } }

    /* ── Manifest ── */
    .manifest-grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 3fr);
      gap: clamp(2rem, 5vw, 5rem);
    }
    .manifest-grid .statement { font-size: clamp(1.7rem, 3.9vw, 3.3rem); line-height: 1.22; }
    .manifest-index { padding-top: 0.6rem; }

    /* ── Exhibition 01 ── */
    .expo-head {
      display: grid;
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
      gap: clamp(2rem, 6vw, 6rem);
      align-items: end;
      margin-bottom: clamp(3rem, 7vh, 5rem);
    }
    .expo-kicker {
      display: flex;
      align-items: center;
      gap: 1.25rem;
      margin-bottom: 1.8rem;
    }
    .expo-kicker .da-logo { height: 30px; width: auto; }
    .expo-kicker .x { font-family: var(--mono); font-size: 0.7rem; color: var(--grey); }
    .expo-kicker .sr-logo { height: 10px; width: auto; }
    .expo-film .frame { aspect-ratio: 16 / 9; }
    .expo-objects { margin-top: clamp(4rem, 9vh, 6.5rem); }
    .expo-foot {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: center;
      gap: 1.5rem;
      margin-top: clamp(3rem, 7vh, 5rem);
      padding-top: 2rem;
      border-top: 1px solid var(--line);
    }

    @media (max-width: 900px) {
      .stage { height: 230vh; --t: 54vh; --l: var(--pad); --b: 9vh; }
      .stage-copy { top: 12vh; bottom: auto; justify-content: flex-start; gap: 1.1rem; }
      .stage-title { order: -1; font-size: clamp(2.5rem, 11vw, 4.6rem); }
      .stage-intro { font-size: 0.9rem; max-width: 36ch; text-indent: 2em; }
      .stage-meta { grid-template-columns: auto auto; justify-content: space-between; letter-spacing: 0.14em; white-space: nowrap; }
      .stage-meta > :first-child, .stage-tag { display: none; }
      .stage-caption { flex-direction: column; align-items: flex-start; gap: 0.8rem; }
      .manifest-grid, .expo-head { grid-template-columns: 1fr; }
    }
    @media (prefers-reduced-motion: reduce) {
      .stage { height: auto; }
      .stage-sticky { position: relative; }
      html.js .stage-film { animation: none; }
      .stage-film video { opacity: 1; }
    }
  </style>
</head>
<body>
{% set artist = collections.artists | findArtist(home.exhibition.artist) %}
  <div class="grain" aria-hidden="true"></div>

{% include "header.njk" %}

  <main>
    <!-- Film stage -->
    <section class="stage" data-stage aria-label="Introduction">
      <div class="stage-sticky">
        <div class="stage-film">
          <video autoplay muted loop playsinline preload="auto"
                 poster="{{ home.film.poster }}"
                 src="{{ home.film.src_mobile }}"
                 data-src-sm="{{ home.film.src_mobile }}"
                 data-src-lg="{{ home.film.src_desktop }}"
                 onloadeddata="this.classList.add('is-ready')"
                 aria-label="{{ home.film.alt }}"></video>
        </div>

        <p class="stage-tag mono">{{ home.film.tag }}</p>

        <div class="stage-copy">
          <p class="stage-intro">
            {{ home.intro }}
          </p>
          <h1 class="stage-title display" data-split data-delay="250">{% for line in home.title_lines %}{{ line }}{% if not loop.last %}<br>{% endif %}{% endfor %}</h1>
        </div>

        <div class="stage-meta mono">
          <span>{{ home.meta_left }}</span>
          <span class="stage-scroll">{{ home.meta_scroll }}</span>
          <span>{{ home.meta_right }}</span>
        </div>

        <div class="stage-caption">
          <p class="stage-caption-title">{{ home.film.caption_title }}</p>
          <p class="mono">{{ home.film.caption_meta }}</p>
        </div>
      </div>
    </section>

    <!-- Marquee -->
    <div class="marquee" data-marquee aria-hidden="true">
      <div class="marquee-track">
        <div class="marquee-group">
{%- for word in home.marquee %}
          <span{% if word.outline %} class="outline"{% endif %}>{{ word.text }}</span><span class="sep">&mdash;</span>
{%- endfor %}
        </div>
      </div>
    </div>

    <!-- Manifest -->
    <section class="section dark" id="manifest">
      <div class="manifest-grid">
        <div>
          <p class="section-label">{{ home.manifest_label }}</p>
        </div>
        <p class="statement" data-scrub>
          {{ home.manifest }}
        </p>
      </div>
    </section>

    <!-- Exhibition 01 -->
    <section class="section" id="exhibition">
      <p class="section-label">{{ home.exhibition.label }}</p>

      <div class="expo-head">
        <div>
          <div class="expo-kicker reveal">
            <img class="da-logo" src="{{ artist.data.logo }}" alt="{{ artist.data.title }}">
            <span class="x">&times;</span>
            <img class="sr-logo" src="{{ site.logo_ink }}" alt="{{ site.name }}">
          </div>
          <h2 class="display" data-split>{% for line in home.exhibition.title_lines %}{{ line }}{% if not loop.last %}<br>{% endif %}{% endfor %}</h2>
        </div>
        <div class="body-text reveal d2">
          {{ home.exhibition.text | md | safe }}
        </div>
      </div>

      <figure class="expo-film">
        <div class="frame" data-reveal="clip">
          <video autoplay muted loop playsinline preload="metadata" data-parallax="0.07"
                 poster="{{ artist.data.exhibition.film_poster }}"
                 src="{{ artist.data.exhibition.film }}"></video>
        </div>
        <figcaption class="caption reveal">
          <span>{{ artist.data.exhibition.film_caption_left }}</span>
          <span>{{ artist.data.exhibition.film_caption_right }}</span>
        </figcaption>
      </figure>

      <div class="objects expo-objects">
{%- set delays = ["", "120ms", "240ms"] %}
{%- set classes = ["", " d1", " d2"] %}
{%- for object in artist.data.objects | featured(3) %}
        <a class="object" href="{{ artist.url }}">
          <div class="frame" data-reveal="clip"{% if delays[loop.index0] %} style="--d:{{ delays[loop.index0] }}"{% endif %}><img src="{{ object.image }}" alt="{{ object.alt }}" loading="lazy"></div>
          <h3 class="object-title reveal{{ classes[loop.index0] }}">{{ object.name }}</h3>
          <p class="object-meta mono reveal{{ classes[loop.index0] }}">{{ object.home_meta }}</p>
        </a>
{%- endfor %}
      </div>

      <div class="expo-foot reveal">
        <p class="mono">{{ home.exhibition.footnote }}</p>
        <a class="link-arrow" href="{{ artist.url }}">{{ home.exhibition.cta }} <span aria-hidden="true">&rarr;</span></a>
      </div>
    </section>

    <!-- Contact -->
    <section class="section contact" id="contact">
      <p class="section-label">{{ home.contact_label }}</p>
      <p class="contact-statement" data-split>{{ home.contact_statement }}</p>
{% include "contact-grid.njk" %}
    </section>
  </main>

{% include "footer.njk" %}
</body>
</html>
