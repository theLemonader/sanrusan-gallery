---
permalink: /preview/about/index.html
eleventyComputed:
  pageTitle: "{{ about.title | safe }}"
  pageDescription: "{{ about.description | safe }}"
navContact: "#contact"
current: about
footerLinkHref: /preview/artists/
footerLinkLabel: Artists
eleventyExcludeFromCollections: true
---
<!DOCTYPE html>
<html lang="en">
<head>
{% include "head.njk" %}
  <style>
    .about-intro .statement { max-width: 30ch; }
    .about-cols {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: clamp(2rem, 6vw, 6rem);
      margin-top: clamp(3rem, 7vh, 5rem);
      border-top: 1px solid var(--line);
      padding-top: 2rem;
    }
    .about-cols .body-text { max-width: 50ch; }


    @media (max-width: 860px) {
      .about-cols { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body>
  <div class="grain" aria-hidden="true"></div>

{% include "header.njk" %}

  <main>
    <section class="section page-top about-intro">
      <p class="section-label">{{ about.label }}</p>
      <p class="statement" data-split>
        {{ about.statement_lead }} <span class="dim">{{ about.statement_dim }}</span>
      </p>
      <div class="about-cols">
{%- for column in about.columns %}
        <div class="body-text reveal{% if not loop.first %} d1{% endif %}">
          <p>
            {{ column }}
          </p>
        </div>
{%- endfor %}
      </div>
    </section>

    <section class="section contact" id="contact">
      <p class="section-label">{{ about.contact_label }}</p>
{% include "contact-grid.njk" %}
    </section>
  </main>

{% include "footer.njk" %}
</body>
</html>
