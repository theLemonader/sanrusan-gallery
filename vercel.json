{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "_site",
  "framework": null,
  "redirects": [
    {
      "source": "/preview",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/preview/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/preview/about",
      "destination": "/about/",
      "permanent": true
    },
    {
      "source": "/preview/about/",
      "destination": "/about/",
      "permanent": true
    },
    {
      "source": "/preview/artists/:path*/",
      "destination": "/artists/:path*/",
      "permanent": true
    },
    {
      "source": "/preview/artists/:path*",
      "destination": "/artists/:path*",
      "permanent": true
    },
    {
      "source": "/preview/:path*/",
      "destination": "/:path*/",
      "permanent": true
    },
    {
      "source": "/preview/:path*",
      "destination": "/:path*",
      "permanent": true
    }
  ]
}
